# Only accepted while HOST is a loopback address (local development).
# Any other deployment must use at least 32 random characters:
#   openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-change-me
AUTH_JWT_ISSUER=divevault.local
AUTH_JWT_AUDIENCE=divevault.app
AUTH_TOKEN_TTL_SECONDS=43200
CLI_AUTH_REQUEST_TTL=600
CLI_AUTH_TOKEN_TTL=1800

DATABASE_URL=postgresql://dive:dive@localhost:5432/dive
STARTUP_MIGRATIONS=enabled
METRICS_ENABLED=disabled
REQUEST_TIMEOUT_SECONDS=30
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_REGISTER_PER_WINDOW=5
RATE_LIMIT_GEOCODE_PER_WINDOW=30
RATE_LIMIT_PUBLIC_PER_WINDOW=60
CLI_AUTH_REQUIRE_POLL_TOKEN=true
LOG_FORMAT=text
BACKEND_URL=http://localhost:8000
BACKEND_AUTH_TOKEN=ak_your_token
