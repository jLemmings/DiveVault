{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Zurich",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json",
        "frontend/package-lock.json"
      ],
      "groupName": "frontend npm dependencies"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "backend/go.mod"
      ],
      "groupName": "go modules",
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "docker base images"
    },
    {
      "description": "Runtime dependency updates appear in the changelog and trigger a patch release; dev tooling and CI updates stay as hidden chore commits.",
      "matchDepTypes": [
        "dependencies",
        "require"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "description": "The base image ships in every release, so its updates are runtime dependencies too.",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    }
  ],
  "semanticCommits": "enabled"
}
